# Official France / Russia VFS portal
VFS_DASHBOARD_URL=https://visa.vfsglobal.com/rus/ru/fra/dashboard

# Optional. Prefer `python -m vfs_bot bootstrap` and reuse the saved browser session.
VFS_EMAIL=
VFS_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser / monitoring
HEADLESS=true
LOCALE=ru-RU
TIMEZONE=Europe/Moscow
CHECK_INTERVAL_SECONDS=120
CHECK_JITTER_SECONDS=30
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
HEARTBEAT_HOURS=6

# Files
TARGETS_PATH=targets.yml
DATABASE_PATH=.data/state.db
STORAGE_STATE_PATH=.data/vfs-storage-state.json
DEBUG_DIR=.data/debug
