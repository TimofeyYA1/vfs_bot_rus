# Official France / Russia VFS portal
VFS_DASHBOARD_URL=https://visa.vfsglobal.com/rus/ru/fra/dashboard

# Optional. Used only if the saved session expires and automated re-login is attempted.
VFS_EMAIL=
VFS_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Browser / monitoring
# For VFS, `cdp` is recommended: log in manually in regular Google Chrome,
# then let the monitor attach to that same Chrome instance.
BROWSER_MODE=cdp
HEADLESS=true
LOCALE=ru-RU
TIMEZONE=Europe/Moscow
CDP_URL=http://127.0.0.1:9222
CHECK_INTERVAL_SECONDS=120
CHECK_JITTER_SECONDS=30
NAVIGATION_TIMEOUT_MS=45000
ACTION_TIMEOUT_MS=15000
HEARTBEAT_HOURS=6

# Files
TARGETS_PATH=targets.yml
DATABASE_PATH=.data/state.db
STORAGE_STATE_PATH=.data/vfs-storage-state.json
DEBUG_DIR=.data/debug
